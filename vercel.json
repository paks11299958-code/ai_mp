    { "source": "/api/used-item",            "destination": "http://34.50.27.95:3020/api/aimp/used-item" },
    { "source": "/api/used-item/:path*",     "destination": "http://34.50.27.95:3020/api/aimp/used-item/:path*" },
    { "source": "/api/star",                 "destination": "http://34.50.27.95:3020/api/aimp/star" },
    { "source": "/api/star/:path*",          "destination": "http://34.50.27.95:3020/api/aimp/star/:path*" },
    { "source": "/api/star-thanks",          "destination": "http://34.50.27.95:3020/api/aimp/star-thanks" },
    { "source": "/api/star-thanks/:path*",   "destination": "http://34.50.27.95:3020/api/aimp/star-thanks/:path*" },
    { "source": "/api/payments",             "destination": "http://34.50.27.95:3020/api/aimp/payments" },
    { "source": "/api/payments/:path*",      "destination": "http://34.50.27.95:3020/api/aimp/payments/:path*" },
    { "source": "/api/research",             "destination": "http://34.50.27.95:3020/api/aimp/research" },
    { "source": "/api/research/:path*",      "destination": "http://34.50.27.95:3020/api/aimp/research/:path*" },
    { "source": "/api/product-extract",      "destination": "http://34.50.27.95:3020/api/aimp/product-extract" },
    { "source": "/api/product-extract/:path*", "destination": "http://34.50.27.95:3020/api/aimp/product-extract/:path*" },
    { "source": "/api/math-tutor",           "destination": "http://34.50.27.95:3020/api/aimp/math-tutor" },
    { "source": "/api/math-tutor/:path*",    "destination": "http://34.50.27.95:3020/api/aimp/math-tutor/:path*" },
    { "source": "/api/golf",                 "destination": "http://34.50.27.95:3020/api/aimp/golf" },
    { "source": "/api/golf/:path*",          "destination": "http://34.50.27.95:3020/api/aimp/golf/:path*" },

    { "source": "/api/:d/:s1/:s2/:s3", "destination": "/api/router?d=:d&s1=:s1&s2=:s2&s3=:s3" },
    { "source": "/api/:d/:s1/:s2", "destination": "/api/router?d=:d&s1=:s1&s2=:s2" },
    { "source": "/api/:d/:s1", "destination": "/api/router?d=:d&s1=:s1" },
    { "source": "/api/:d", "destination": "/api/router?d=:d" }
  ]
}
