{
  "buildCommand": "npm install && node scripts/check-react-safety.cjs && npx prisma generate && npm install --prefix frontend && npm run build --prefix frontend && cp -r sites frontend/dist/sites 2>/dev/null || true && mkdir -p frontend/dist/sites/_preview",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/router.ts": {
      "includeFiles": "src/generated/prisma/**",
      "maxDuration": 300
    },
    "api/math-tutor-tts.ts": {
      "maxDuration": 30
    },
    "api/stock-share.ts": {
      "maxDuration": 10
    },
    "api/card-share.ts": {
      "maxDuration": 10
    }
  },
  "redirects": [
    { "source": "/k/:feature", "destination": "/?f=:feature&ref=KIN", "permanent": false },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "ainara2.dbzone.kr" }],
      "destination": "/sites/ainara-partner/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "rental.dbzone.kr"
        }
      ],
      "destination": "/sites/rentalfit-v2/",
      "permanent": false
    },
    {
      "source": "/pro",
      "has": [
        {
          "type": "host",
          "value": "rental.dbzone.kr"
        }
      ],
      "destination": "/sites/rentalfit-v2/pro/",
      "permanent": false
    },
    {
      "source": "/find",
      "has": [{ "type": "host", "value": "rental.dbzone.kr" }],
      "destination": "/sites/rentalfit-v2/find/",
      "permanent": false
    },
    {
      "source": "/find/",
      "has": [{ "type": "host", "value": "rental.dbzone.kr" }],
      "destination": "/sites/rentalfit-v2/find/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sites/rentalfit-v2/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api-proxy", "destination": "/api/api-proxy" },
    { "source": "/s/stock/:id", "destination": "/api/stock-share?id=:id" },
    { "source": "/c/:id", "destination": "/api/card-share?id=:id" },

    { "source": "/sites/:sitename", "destination": "/sites/:sitename/index.html" },
    { "source": "/sites/:sitename/", "destination": "/sites/:sitename/index.html" },
    { "source": "/sites/:sitename/:path*", "destination": "/sites/:sitename/:path*" },


    { "source": "/api/chat-stream", "destination": "https://origin.dbzone.kr/api/aimp/chat-stream" },

