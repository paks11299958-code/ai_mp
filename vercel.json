    { "source": "/api/sessions",             "destination": "http://34.50.27.95:3020/api/aimp/sessions" },
    { "source": "/api/sessions/:path*",      "destination": "http://34.50.27.95:3020/api/aimp/sessions/:path*" },
    { "source": "/api/memory",               "destination": "http://34.50.27.95:3020/api/aimp/memory" },
    { "source": "/api/memory/:path*",        "destination": "http://34.50.27.95:3020/api/aimp/memory/:path*" },
    { "source": "/api/knowledge",            "destination": "http://34.50.27.95:3020/api/aimp/knowledge" },
    { "source": "/api/knowledge/:path*",     "destination": "http://34.50.27.95:3020/api/aimp/knowledge/:path*" },
    { "source": "/api/stock-analysis",       "destination": "http://34.50.27.95:3020/api/aimp/stock-analysis" },
