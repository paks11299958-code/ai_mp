{
  "buildCommand": "npm install && npx prisma generate && npm install --prefix frontend && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "crons": [
    {
      "path": "/api/cron-cleanup",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron-stock-worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron-used-item-worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron-luxury-worker",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "api/router.ts": {
      "includeFiles": "src/generated/prisma/**",
      "maxDuration": 300
    },
    "api/math-tutor-tts.ts": {
      "maxDuration": 30
    },
    "api/cron-stock-worker.ts": {
      "includeFiles": "src/generated/prisma/**",
      "maxDuration": 300
    },
    "api/cron-used-item-worker.ts": {
      "includeFiles": "src/generated/prisma/**",
      "maxDuration": 300
    },
    "api/cron-luxury-worker.ts": {
      "includeFiles": "src/generated/prisma/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api-proxy", "destination": "/api/api-proxy" },

    { "source": "/api/auth",                       "destination": "http://34.50.27.95:3020/api/aimp/auth" },
    { "source": "/api/auth/:path*",                "destination": "http://34.50.27.95:3020/api/aimp/auth/:path*" },
    { "source": "/api/settings",                   "destination": "http://34.50.27.95:3020/api/aimp/settings" },
    { "source": "/api/settings/:path*",            "destination": "http://34.50.27.95:3020/api/aimp/settings/:path*" },
    { "source": "/api/personas",                   "destination": "http://34.50.27.95:3020/api/aimp/personas" },
    { "source": "/api/personas/:path*",            "destination": "http://34.50.27.95:3020/api/aimp/personas/:path*" },
    { "source": "/api/persona-videos",             "destination": "http://34.50.27.95:3020/api/aimp/persona-videos" },
    { "source": "/api/persona-videos/:path*",      "destination": "http://34.50.27.95:3020/api/aimp/persona-videos/:path*" },
    { "source": "/api/trigger-videos",             "destination": "http://34.50.27.95:3020/api/aimp/trigger-videos" },
    { "source": "/api/trigger-videos/:path*",      "destination": "http://34.50.27.95:3020/api/aimp/trigger-videos/:path*" },
    { "source": "/api/face-reading",               "destination": "http://34.50.27.95:3020/api/aimp/face-reading" },
    { "source": "/api/face-reading/:path*",        "destination": "http://34.50.27.95:3020/api/aimp/face-reading/:path*" },
    { "source": "/api/quick-menu-result",          "destination": "http://34.50.27.95:3020/api/aimp/quick-menu/result" },
    { "source": "/api/quick-menu-activate",        "destination": "http://34.50.27.95:3020/api/aimp/quick-menu/activate" },
    { "source": "/api/hot-keyword",                "destination": "http://34.50.27.95:3020/api/aimp/hot-keyword" },
    { "source": "/api/hot-keyword/:path*",         "destination": "http://34.50.27.95:3020/api/aimp/hot-keyword/:path*" },
    { "source": "/api/categories",           "destination": "http://34.50.27.95:3020/api/aimp/categories" },
    { "source": "/api/categories/:path*",    "destination": "http://34.50.27.95:3020/api/aimp/categories/:path*" },
