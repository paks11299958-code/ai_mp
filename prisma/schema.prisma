generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int                 @id @default(autoincrement())
  email            String?             @unique
  phone            String?             @unique
  password         String
  username         String?
  role             String              @default("USER")
  resetToken       String?
  resetTokenExpiry DateTime?
  paidPoints       Int                 @default(0)
  bonusPoints      Int                 @default(0)
  birthInfoJson    String?
  createdAt        DateTime            @default(now())
  personas         Persona[]
  sessions         ChatSession[]
  memories         UserMemory[]
  personaXps       UserPersonaXp[]
  boardPosts       BoardPost[]
  boardReplies     BoardReply[]
  swingAnalyses    UserSwingAnalysis[]
  pointTransactions PointTransaction[]
  starsGiven        Star[]             @relation("GivenBy")
  partnerPosts      PartnerPost[]
  partnerReplies    PartnerReply[]
  stockAnalyses     StockAnalysis[]
  usedItemListings    UsedItemListing[]
  luxuryVerifications LuxuryVerification[]
  menuUsageLogs     MenuUsageLog[]
}

model UserPersonaXp {
  userId    Int
  personaId String
  xp        Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  @@id([userId, personaId])
}

model UserMemory {
  id        Int                      @id @default(autoincrement())
  userId    Int
  content   String
  embedding Unsupported("vector(768)")?
  category  String?
  createdAt DateTime                 @default(now())
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  personas  Persona[]
}

model Persona {
  id                String          @id @default(cuid())
  name              String
  jobTitle          String?
  description       String?
  systemInstruction String
  identityPrompt    String?
  iconName          String          @default("Bot")
  colorClass        String          @default("from-blue-500 to-cyan-500")
  order             Int             @default(0)
  imageUrl          String?
  introVideoUrl     String?
  starVideoUrl      String?
  faceReadingBgUrl  String?
  chatBgUrl         String?
  quickMenuJson     String?
  isDefault         Boolean         @default(false)
  isVisible         Boolean         @default(true)
  adminOnly         Boolean         @default(false)
  createdBy         Int?
  categoryId        Int?
  user              User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  category          Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  sessions          ChatSession[]
  images            PersonaImage[]
  personaXps        UserPersonaXp[]
  knowledge         PersonaKnowledge[]
  boardPosts        BoardPost[]
  triggerVideos     PersonaTriggerVideo[]
  swingAnalyses     UserSwingAnalysis[]
  announcements     Announcement[]
  stars             Star[]
  pointTransactions PointTransaction[]
}

model PersonaImage {
  id            Int            @id @default(autoincrement())
  personaId     String
  imageUrl      String
  description   String?
  isMain        Boolean        @default(false)
  order         Int            @default(0)
  requiredLevel Int            @default(1)
  createdAt     DateTime       @default(now())
  persona       Persona        @relation(fields: [personaId], references: [id], onDelete: Cascade)
  videos        PersonaVideo[]
}

model PersonaVideo {
  id            Int          @id @default(autoincrement())
  imageId       Int
  videoUrl      String
  title         String?
  order         Int          @default(0)
  requiredLevel Int          @default(1)
  createdAt     DateTime     @default(now())
  image         PersonaImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        Int                  @id @default(autoincrement())
  userId    Int
  personaId String
  title     String?
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona   Persona              @relation(fields: [personaId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  messages  Message[]
  summary   ConversationSummary?
}

model Message {
  id        Int         @id @default(autoincrement())
  sessionId Int
  role      String
  text      String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
}

model ConversationSummary {
  id           Int         @id @default(autoincrement())
  sessionId    Int         @unique
  summary      String
  messageCount Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PersonaKnowledge {
  id        Int                       @id @default(autoincrement())
  personaId String
  sourceId  String?
  title     String?
  content   String
  embedding Unsupported("vector(768)")?
  createdAt DateTime                  @default(now())
  persona   Persona                   @relation(fields: [personaId], references: [id], onDelete: Cascade)
}

model PersonaTriggerVideo {
  id          Int      @id @default(autoincrement())
  personaId   String
  videoUrl    String
  title       String?
  description String?
  keywords    String
  tag         String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  persona     Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
}

model BoardPost {
  id        Int          @id @default(autoincrement())
  userId    Int
  personaId String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona   Persona      @relation(fields: [personaId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  replies   BoardReply[]
}

model UserSwingAnalysis {
  id           Int      @id @default(autoincrement())
  userId       Int
  personaId    String
  fileName     String?
  analysisJson String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona      Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
}

model BoardReply {
  id           Int       @id @default(autoincrement())
  postId       Int
  post         BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  isAdminReply Boolean   @default(false)
  content      String
  createdAt    DateTime  @default(now())
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  category  String   @default("update")
  isPinned  Boolean  @default(false)
  isVisible Boolean  @default(true)
  personaId String?
  persona   Persona? @relation(fields: [personaId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PointTransaction {
  id           Int      @id @default(autoincrement())
  userId       Int
  amount       Int
  type         String
  description  String?
  personaId    String?
  balanceAfter Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona      Persona? @relation(fields: [personaId], references: [id], onDelete: SetNull)
}

model Star {
  id          Int      @id @default(autoincrement())
  fromUserId  Int
  personaId   String
  amount      Int
  pointsSpent Int
  message     String?
  createdAt   DateTime @default(now())
  fromUser    User     @relation("GivenBy", fields: [fromUserId], references: [id], onDelete: Cascade)
  persona     Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@map("StarBalloon")
}

model PendingVerification {
  id         Int      @id @default(autoincrement())
  type       String
  identifier String   @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  sentCount  Int      @default(1)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

model PartnerPost {
  id        Int           @id @default(autoincrement())
  userId    Int
  title     String
  content   String
  contact   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   PartnerReply[]
}

model PartnerReply {
  id           Int         @id @default(autoincrement())
  postId       Int
  post         PartnerPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId       Int
  user         User        @relation(fields: [userId], references: [id])
  isAdminReply Boolean     @default(false)
  content      String
  createdAt    DateTime    @default(now())
}

model CorpCode {
  corpCode    String  @id
  corpName    String
  corpNameEng String?
  stockCode   String?
  modifyDt    String?

  @@index([corpName])
  @@index([corpNameEng])
}

model StockAnalysis {
  id             Int      @id @default(autoincrement())
  userId         Int
  stockName      String
  corpCode       String?
  yahooSymbol    String?
  chartImageUrl  String?
  status         String   @default("pending")
  analysisReport String?
  claudeReport   String?
  gptReport      String?
  sourceLinks    String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StockReportChunk {
  id          Int      @id @default(autoincrement())
  userId      Int
  ticker      String
  stockName   String
  reportDate  String
  quarter     String?
  chunkIndex  Int
  content     String
  embedding   Unsupported("vector(768)")?
  createdAt   DateTime @default(now())

  @@index([userId, ticker])
}

model LuxuryVerification {
  id               Int      @id @default(autoincrement())
  userId           Int
  imageUrls        String   @default("[]")
  brandHint        String?
  status           String   @default("pending")
  // Gemini 분석
  geminiBrand      String?
  geminiModel      String?
  geminiScore      Int?
  geminiPoints     String?
  geminiVerdict    String?
  geminiSummary    String?
  // Claude 분석
  claudeBrand      String?
  claudeModel      String?
  claudeScore      Int?
  claudePoints     String?
  claudeVerdict    String?
  claudeSummary    String?
  // GPT-4o 분석
  gptBrand         String?
  gptModel         String?
  gptScore         Int?
  gptPoints        String?
  gptVerdict       String?
  gptSummary       String?
  // 종합 결과
  finalScore       Int?
  finalVerdict     String?
  agreements       String?
  disagreements    String?
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsedItemListing {
  id               Int      @id @default(autoincrement())
  userId           Int
  imageUrls        String   @default("[]")
  itemName         String?
  status           String   @default("pending")
  category         String?
  brand            String?
  modelName        String?
  condition        String?
  conditionDetail  String?
  visibleDamage    String?
  includedItems    String?
  confidence       Float?
  suggestedPrice   Int?
  claudePrice      Int?
  gptPrice         Int?
  minPrice         Int?
  maxPrice         Int?
  priceReason      String?
  aiTitle          String?
  aiDescription    String?
  aiHashtags       String?
  finalTitle       String?
  finalPrice       Int?
  finalDescription String?
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NaverShoppingCategory {
  id       Int    @id @default(autoincrement())
  code     String @unique
  name     String
  emoji    String
  keywords String
  order    Int    @default(0)
}

// 기능별·역할별 정책 테이블 (관리자가 DB에서 직접 수정 가능)
model MenuLimit {
  feature    String  // 'golf', 'stock', 'used-item', 'hot-keyword', 'face', 'quick-menu'
  role       String  // 'USER', 'MANAGE', 'ADMIN'
  dailyLimit Int?    // null = 무제한, 1 = 1일 1회
  pointsCost Int     @default(50)

  @@id([feature, role])
}

// 기능 사용 일별 추적 (dailyLimit 체크용)
model MenuUsageLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  feature   String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, feature, createdAt])
}

model GolfBookingSchedule {
  id          Int       @id @default(autoincrement())
  userId      Int
  courseId    Int
  golfDate    String
  timePeriod  String
  scheduledAt DateTime
  openAt      DateTime?
  status      String    @default("pending")
  resultMsg   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, scheduledAt])
}

model GolfCourse {
  id           Int      @id @default(autoincrement())
  name         String
  sido         String
  sigungu      String
  address      String?
  bookingUrl   String?
  hasAuto      Boolean  @default(false)
  bookerType   String?
  loginId      String?
  loginPw      String?
  advanceDays  Int      @default(30)
  openHour     Int      @default(0)
  openMinute   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sido, sigungu])
}

model AiUsageLog {
  id               Int      @id @default(autoincrement())
  service          String
  model            String
  feature          String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costUsd          Float    @default(0)
  userId           Int?
  createdAt        DateTime @default(now())

  @@index([service, createdAt])
  @@index([createdAt])
}
