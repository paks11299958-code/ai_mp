generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int                 @id @default(autoincrement())
  email            String?             @unique
  phone            String?             @unique
  password         String
  username         String?
  role             String              @default("USER")
  resetToken       String?
  resetTokenExpiry DateTime?
  paidPoints       Int                 @default(0)
  bonusPoints      Int                 @default(0)
  birthInfoJson    String?
  createdAt        DateTime            @default(now())
  personas         Persona[]
  sessions         ChatSession[]
  memories         UserMemory[]
  personaXps       UserPersonaXp[]
  boardPosts       BoardPost[]
  boardReplies     BoardReply[]
  swingAnalyses    UserSwingAnalysis[]
  pointTransactions PointTransaction[]
  starsGiven        Star[]             @relation("GivenBy")
  partnerPosts      PartnerPost[]
  partnerReplies    PartnerReply[]
  stockAnalyses     StockAnalysis[]
  usedItemListings    UsedItemListing[]
  luxuryVerifications LuxuryVerification[]
  menuUsageLogs     MenuUsageLog[]
}

model UserPersonaXp {
  userId    Int
  personaId String
  xp        Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  @@id([userId, personaId])
}

model UserMemory {
  id        Int                      @id @default(autoincrement())
  userId    Int
  content   String
  embedding Unsupported("vector(768)")?
  category  String?
  createdAt DateTime                 @default(now())
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  personas  Persona[]
}

model Persona {
  id                String          @id @default(cuid())
  name              String
  jobTitle          String?
  description       String?
  systemInstruction String
  identityPrompt    String?
  iconName          String          @default("Bot")
  colorClass        String          @default("from-blue-500 to-cyan-500")
  order             Int             @default(0)
  imageUrl          String?
  introVideoUrl     String?
  starVideoUrl      String?
  faceReadingBgUrl  String?
  chatBgUrl         String?
  quickMenuJson     String?
  isDefault         Boolean         @default(false)
  isVisible         Boolean         @default(true)
  adminOnly         Boolean         @default(false)
  useGrounding      Boolean         @default(false)
  createdBy         Int?
  categoryId        Int?
  user              User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  category          Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  sessions          ChatSession[]
  images            PersonaImage[]
  personaXps        UserPersonaXp[]
  knowledge         PersonaKnowledge[]
  boardPosts        BoardPost[]
  triggerVideos     PersonaTriggerVideo[]
  swingAnalyses     UserSwingAnalysis[]
  announcements     Announcement[]
  stars             Star[]
  pointTransactions PointTransaction[]
}

model PersonaImage {
  id            Int            @id @default(autoincrement())
  personaId     String
  imageUrl      String
  description   String?
  isMain        Boolean        @default(false)
  order         Int            @default(0)
  requiredLevel Int            @default(1)
  createdAt     DateTime       @default(now())
  persona       Persona        @relation(fields: [personaId], references: [id], onDelete: Cascade)
  videos        PersonaVideo[]
}

model PersonaVideo {
  id            Int          @id @default(autoincrement())
  imageId       Int
  videoUrl      String
  title         String?
  order         Int          @default(0)
  requiredLevel Int          @default(1)
  createdAt     DateTime     @default(now())
  image         PersonaImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        Int                  @id @default(autoincrement())
  userId    Int
  personaId String
  title     String?
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona   Persona              @relation(fields: [personaId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  messages  Message[]
  summary   ConversationSummary?
}

model Message {
  id        Int         @id @default(autoincrement())
  sessionId Int
  role      String
  text      String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
}

model ConversationSummary {
  id           Int         @id @default(autoincrement())
  sessionId    Int         @unique
  summary      String
  messageCount Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PersonaKnowledge {
  id        Int                       @id @default(autoincrement())
  personaId String
  sourceId  String?
  title     String?
  content   String
  embedding Unsupported("vector(768)")?
  createdAt DateTime                  @default(now())
  persona   Persona                   @relation(fields: [personaId], references: [id], onDelete: Cascade)
}

model PersonaTriggerVideo {
  id          Int      @id @default(autoincrement())
  personaId   String
  videoUrl    String
  title       String?
  description String?
  keywords    String
  tag         String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  persona     Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
}

model BoardPost {
  id        Int          @id @default(autoincrement())
  userId    Int
  personaId String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona   Persona      @relation(fields: [personaId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  replies   BoardReply[]
}

model UserSwingAnalysis {
  id           Int      @id @default(autoincrement())
  userId       Int
  personaId    String
  fileName     String?
  title        String?
  gender       String?
  skillLevel   String?  @map("skill_level")
  analysisJson String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona      Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
}

model BoardReply {
  id           Int       @id @default(autoincrement())
  postId       Int
  post         BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  isAdminReply Boolean   @default(false)
  content      String
  createdAt    DateTime  @default(now())
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  category  String   @default("update")
  isPinned  Boolean  @default(false)
  isVisible Boolean  @default(true)
  personaId String?
  persona   Persona? @relation(fields: [personaId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PointTransaction {
  id           Int      @id @default(autoincrement())
  userId       Int
  amount       Int
  type         String
  description  String?
  orderId      String?  @unique   // 충전(CHARGE) 결제 orderId — 중복 결제 DB 레벨 차단
  personaId    String?
  balanceAfter Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona      Persona? @relation(fields: [personaId], references: [id], onDelete: SetNull)
}

model Star {
  id          Int      @id @default(autoincrement())
  fromUserId  Int
  personaId   String
  amount      Int
  pointsSpent Int
  message     String?
  createdAt   DateTime @default(now())
  fromUser    User     @relation("GivenBy", fields: [fromUserId], references: [id], onDelete: Cascade)
  persona     Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@map("StarBalloon")
}

model PendingVerification {
  id         Int      @id @default(autoincrement())
  type       String
  identifier String   @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  sentCount  Int      @default(1)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

model PartnerPost {
  id        Int           @id @default(autoincrement())
  userId    Int
  title     String
  content   String
  contact   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   PartnerReply[]
}

model PartnerReply {
  id           Int         @id @default(autoincrement())
  postId       Int
  post         PartnerPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId       Int
  user         User        @relation(fields: [userId], references: [id])
  isAdminReply Boolean     @default(false)
  content      String
  createdAt    DateTime    @default(now())
}

model CorpCode {
  corpCode    String  @id
  corpName    String
  corpNameEng String?
  stockCode   String?
  modifyDt    String?

  @@index([corpName])
  @@index([corpNameEng])
}

model StockAnalysis {
  id             Int      @id @default(autoincrement())
  userId         Int
  stockName      String
  corpCode       String?
  yahooSymbol    String?
  chartImageUrl  String?
  status         String   @default("pending")
  analysisReport String?
  claudeReport   String?
  gptReport      String?
  sourceLinks    String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StockReportChunk {
  id          Int      @id @default(autoincrement())
  userId      Int
  ticker      String
  stockName   String
  reportDate  String
  quarter     String?
  chunkIndex  Int
  content     String
  embedding   Unsupported("vector(768)")?
  createdAt   DateTime @default(now())

  @@index([userId, ticker])
}

model LuxuryVerification {
  id               Int      @id @default(autoincrement())
  userId           Int
  imageUrls        String   @default("[]")
  brandHint        String?
  status           String   @default("pending")
  // Gemini 분석
  geminiBrand      String?
  geminiModel      String?
  geminiScore      Int?
  geminiPoints     String?
  geminiVerdict    String?
  geminiSummary    String?
  // Claude 분석
  claudeBrand      String?
  claudeModel      String?
  claudeScore      Int?
  claudePoints     String?
  claudeVerdict    String?
  claudeSummary    String?
  // GPT-4o 분석
  gptBrand         String?
  gptModel         String?
  gptScore         Int?
  gptPoints        String?
  gptVerdict       String?
  gptSummary       String?
  // 종합 결과
  finalScore       Int?
  finalVerdict     String?
  agreements       String?
  disagreements    String?
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsedItemListing {
  id               Int      @id @default(autoincrement())
  userId           Int
  imageUrls        String   @default("[]")
  itemName         String?
  status           String   @default("pending")
  category         String?
  brand            String?
  modelName        String?
  condition        String?
  conditionDetail  String?
  visibleDamage    String?
  includedItems    String?
  confidence       Float?
  suggestedPrice   Int?
  claudePrice      Int?
  gptPrice         Int?
  minPrice         Int?
  maxPrice         Int?
  priceReason      String?
  aiTitle          String?
  aiDescription    String?
  aiHashtags       String?
  finalTitle       String?
  finalPrice       Int?
  finalDescription String?
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NaverShoppingCategory {
  id       Int    @id @default(autoincrement())
  code     String @unique
  name     String
  emoji    String
  keywords String
  order    Int    @default(0)
}

// 기능별·역할별 정책 테이블 (관리자가 DB에서 직접 수정 가능)
model MenuLimit {
  feature    String  // 'golf', 'stock', 'used-item', 'hot-keyword', 'face', 'quick-menu'
  role       String  // 'USER', 'MANAGE', 'ADMIN'
  dailyLimit Int?    // null = 무제한, 1 = 1일 1회
  pointsCost Int     @default(50)

  @@id([feature, role])
}

// 기능 사용 일별 추적 (dailyLimit 체크용)
model MenuUsageLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  feature   String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, feature, createdAt])
}

model GolfBookingSchedule {
  id          Int       @id @default(autoincrement())
  userId      Int
  courseId    Int
  golfDate    String
  timePeriod  String
  scheduledAt DateTime
  openAt      DateTime?
  status      String    @default("pending")
  resultMsg   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, scheduledAt])
}

model GolfCourse {
  id           Int      @id @default(autoincrement())
  name         String
  sido         String
  sigungu      String
  address      String?
  bookingUrl   String?
  hasAuto      Boolean  @default(false)
  bookerType   String?
  loginId      String?
  loginPw      String?
  advanceDays  Int      @default(30)
  openHour     Int      @default(0)
  openMinute   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sido, sigungu])
}

model AiUsageLog {
  id               Int      @id @default(autoincrement())
  service          String
  model            String
  feature          String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costUsd          Float    @default(0)
  userId           Int?
  createdAt        DateTime @default(now())

  @@index([service, createdAt])
  @@index([createdAt])
}

// 윤채린 헤어스타일 견본 (Imagen 생성, 어드민 관리). gender: 'male' | 'female'
model HairStyle {
  id          Int      @id @default(autoincrement())
  styleKey    String   @unique          // f_bob, m_twoblock 등
  name        String                    // 단발 보브, 투블럭
  gender      String                    // 'male' | 'female'
  imageUrl    String
  promptEn    String?                   // 생성에 쓴 영문 헤어 설명(어울림 분석 참고용)
  description String?
  order       Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([gender, order])
}

// ─────────────────────────────────────────────────────────────
// 인버스 ETF 1호가 스캘핑 자동매매 (SIMULATION 전용)
// 모든 모델은 Inverse 접두사로 기존 모델과 이름 충돌을 피한다.
// 금액/손익은 Float(원), 수량·가격은 Int(원 단위 정수, 호가단위 5원).
// ※ 일일집계(InverseDailyStat)의 누적 수량은 Int32(21.4억) 상한을 넘길 수 있어
//   Float으로 둔다. 기본주문수량 100만주 기준 하루 2,148회 매수면 Int는 오버플로.
// ─────────────────────────────────────────────────────────────

/// 자동매매 설정(종목·수량·리스크 한도). 어드민에서 관리.
model InverseTraderConfig {
  id             Int      @id @default(autoincrement())
  symbol         String // 종목코드 (예: 252670)
  symbolName     String // 종목명 (예: KODEX 200선물인버스2X)
  defaultQty     Int      @default(1000000) // 기본 주문수량(주)
  closeBufferMin Int      @default(10) // 마감 전 강제정산 버퍼(분)
  maxPositionQty Int      @default(3000000) // 최대 보유수량(주)
  dailyLossLimit Float    @default(500000) // 일일 최대 손실액(원). 초과 시 정지

  /// 손절 발동 하락률(%, 양수). 0이면 손절 안 함.
  /// ★백테스트에서 이 전략의 최대 약점이 '손절 부재'로 확인됐다(급락 시나리오에서
  ///   물량이 깔린 채 마감 강제청산으로 손실이 확정). 특히 KODEX 200선물인버스2X는
  ///   2배 레버리지라 하루 -12%가 실제로 나온다.
  stopLossPct        Float @default(2)
  /// 허용할 최대 추가매수(물타기) 횟수. 0이면 제한 없음.
  maxAddBuys         Int   @default(10)
  /// 진입가 대비 이 하락률(%)을 넘으면 신규 매수를 멈춘다. 0이면 제한 없음.
  noAddBuyBelowPct   Float @default(3)

  tradingMode    String   @default("SIMULATION") // 'SIMULATION' 고정 (LIVE 금지)
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([symbol])
}

/// 주문 원장. 부모 체결로 파생된 후속주문은 parentOrderId로 추적한다.
model InverseOrder {
  id            Int      @id @default(autoincrement())
  sessionId     String // InverseTraderSession.id
  symbol        String
  side          String // 'BUY' | 'SELL'
  limitPrice    Int // 지정가(원)
  orderQty      Int // 주문수량
  filledQty     Int      @default(0) // 누적 체결수량
  remainingQty  Int // 잔량 (orderQty - filledQty)
  status        String   @default("PENDING") // PENDING | PARTIAL | FILLED | CANCELED
  parentOrderId Int? // 원인주문ID(이 주문을 낳은 체결의 주문)
  brokerOrderId String? // 브로커(시뮬레이터)가 발급한 주문번호
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sessionId, createdAt])
  @@index([symbol])
}

/// 체결 내역. 시뮬레이션 브로커가 반환하는 체결 객체와 같은 형태.
model InverseFill {
  id        Int      @id @default(autoincrement())
  orderId   Int // InverseOrder.id
  symbol    String
  side      String // 'BUY' | 'SELL'
  fillPrice Int // 체결가(원)
  fillQty   Int // 체결수량
  filledAt  DateTime @default(now()) // 체결시각

  @@index([orderId])
  @@index([symbol, filledAt])
}

/// 세션×종목 보유 포지션(현재 상태 스냅샷).
model InversePosition {
  id            Int      @id @default(autoincrement())
  sessionId     String
  symbol        String
  qty           Int      @default(0) // 보유수량
  avgPrice      Float    @default(0) // 평균단가(원)
  realizedPnl   Float    @default(0) // 실현손익(원)
  unrealizedPnl Float    @default(0) // 평가손익(원)
  updatedAt     DateTime @updatedAt

  @@unique([sessionId, symbol])
}

/// 일자별 집계(어드민 손익 화면 원천).
model InverseDailyStat {
  id           Int      @id @default(autoincrement())
  date         DateTime @unique @db.Date // 영업일
  sessionId    String?
  buyQty       Float    @default(0) // 총매수 수량(누적 오버플로 방지로 Float)
  buyAmount    Float    @default(0) // 총매수 금액(원)
  sellQty      Float    @default(0) // 총매도 수량(누적 오버플로 방지로 Float)
  sellAmount   Float    @default(0) // 총매도 금액(원)
  realizedPnl  Float    @default(0) // 실현손익(원)
  fillCount    Int      @default(0) // 체결건수
  forceSettled Boolean  @default(false) // 마감 강제정산 성공 여부
  closingQty   Int      @default(0) // 마감 시 잔여수량
  note         String? // 비고
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sessionId])
}

/// 자동매매 세션(구동 단위). 어드민 상태 표시의 기준.
model InverseTraderSession {
  id        String    @id @default(cuid())
  status    String    @default("IDLE") // IDLE | RUNNING | FORCE_SETTLEMENT | STOPPED | EMERGENCY_STOP
  startedAt DateTime?
  endedAt   DateTime?
  lastError String? // 마지막 에러 메시지
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, startedAt])
}

// ─────────────────────────────────────────────────────────────────
// 개발AI 콘솔 (2026-08-20 신설)
//
// 텔레그램으로 한 줄씩 지시하던 허드 개발 파이프라인을, 어드민에서 명세를 쓰고
// 진행을 보고 결과를 받는 작업대로 옮긴다. 텔레그램은 알림 전용으로 축소한다.
//
// ★동시 실행은 1건으로 제한한다(사장 결정 2026-08-20). pane 안 claude 하나가
//   400MB~3.2GB를 먹는데 서버2는 3.9GB다. 대기는 큐(status=queued)로 둔다.
// ─────────────────────────────────────────────────────────────────

/// 개발 프로젝트 1건. 허드 파이프라인의 projectId(p180458 등)와 연결된다.
model DevProject {
  id          String  @id @default(cuid())
  title       String
  /// draft(작성중) → queued(대기) → planned(계획됨) → awaiting_approval(승인대기)
  /// → running(개발중) → review(검증중) → done / failed / canceled
  status      String  @default("draft")
  /// 허드 파이프라인이 부여한 프로젝트 ID(rag/state/projects/<ID>.json). 착수 전엔 null.
  herdrProjectId String?
  /// 작업 저장소 경로. 기본은 ai_mp.
  workdir     String  @default("/home/paks11299958/ai_mp")

  versions    DevProjectVersion[]
  files       DevProjectFile[]
  events      DevProjectEvent[]
  result      DevProjectResult?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, updatedAt])
}

/// 명세 버전 — '비포/애프터'의 실체.
/// ★수정 시 UPDATE 가 아니라 INSERT 한다. 덮어쓰면 무엇을 왜 바꿨는지가 사라진다.
model DevProjectVersion {
  id          Int      @id @default(autoincrement())
  projectId   String
  project     DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 1부터 증가
  version     Int
  /// 만들 기능 목록(여러 줄)
  features    String   @default("")
  /// 명세 본문(마크다운)
  specBody    String   @default("")
  /// 참조 사이트 URL 목록(JSON 배열 문자열)
  refUrls     String   @default("[]")
  /// 홈페이지 요구사항(JSON 문자열). 상호명·서비스·톤앤매너·연락처 등.
  /// ★칼럼을 15개로 쪼개지 않고 JSON 한 칸에 둔다 — 항목이 계속 늘어날 자리이고,
  ///   버전마다 통째로 스냅샷돼야 비포/애프터 비교가 그대로 성립한다.
  /// ★연락처(주소·전화·이메일·사업자번호)는 비어 있으면 **비워둔 채로 둔다**.
  ///   AI가 지어내면 실제 고객이 잘못된 곳으로 연락한다(사장 지시 2026-08-20).
  brief       String   @default("{}")
  /// 이 버전에서 무엇을 왜 바꿨는지
  note        String?
  createdAt   DateTime @default(now())

  @@unique([projectId, version])
  @@index([projectId, version])
}

/// 첨부 파일 — MVP 명세서 / 참조 이미지 / 디자인 소스.
/// ★이미지는 sites 방식으로 저장한다(사장 결정 2026-08-20):
///   저장소 안 sites/devai/<projectId>/img/ 에 두고 URL로 서빙한다.
///   외부 스토리지를 쓰지 않으므로 배포와 함께 그대로 따라간다.
model DevProjectFile {
  id          Int      @id @default(autoincrement())
  projectId   String
  project     DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// spec(명세서) | image(참조 이미지) | design(디자인 소스) | result(결과물)
  kind        String
  fileName    String
  /// 브라우저에서 접근할 경로. 예: /sites/devai/<projectId>/img/hero.png
  url         String
  /// 바이트
  size        Int      @default(0)
  mimeType    String?
  createdAt   DateTime @default(now())

  @@index([projectId, kind])
}

/// 진행 이벤트 — '작업' 탭 화면의 원천.
/// ★허드 pane 화면을 그대로 중계하지 않는다. read_output 은 TUI 스냅샷이라
///   잘리거나 비어서 나온다(실측). 파이프라인이 여기에 구조화해서 적는다.
model DevProjectEvent {
  id          Int      @id @default(autoincrement())
  projectId   String
  project     DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// system | developer | reviewer | user
  actor       String   @default("system")
  /// plan | approval | batch_start | batch_done | review | commit | deploy | error
  phase       String
  message     String
  /// 부가 정보(커밋해시·묶음명·pane ID 등) JSON 문자열
  meta        String?
  at          DateTime @default(now())

  @@index([projectId, at])
}

/// 완료 결과 — '완료' 탭에서 보여준다.
model DevProjectResult {
  id          Int      @id @default(autoincrement())
  projectId   String   @unique
  project     DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployUrl   String?
  /// 사이트 내용 요약
  summary     String?
  /// 커밋 해시 목록(JSON 배열 문자열)
  commits     String   @default("[]")
  /// 디자인 소스 묶음(zip) 경로
  designSourceUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
