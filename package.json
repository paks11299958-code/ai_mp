{
  "name": "multi-persona-ai-chat",
  "version": "2.0.1",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "npm run frontend",
    "local": "concurrently \"node local-api.cjs\" \"npm run frontend\"",
    "api": "node local-api.cjs",
    "frontend": "npm run dev --prefix frontend",
    "check": "node scripts/check-react-safety.cjs",
    "smoke": "node scripts/smoke-test.cjs",
    "predeploy": "node scripts/check-react-safety.cjs && npm run build --prefix frontend",
    "verify": "node scripts/check-react-safety.cjs && cd frontend && npx tsc --noEmit",
    "install-hooks": "bash scripts/install-hooks.sh"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "concurrently": "latest",
    "express": "^4.21.2",
    "prisma": "^7.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@types/pg": "^8.20.0",
    "@types/sharp": "^0.31.1",
    "@vercel/node": "^5.7.13",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.37.0",
    "pg": "^8.20.0",
    "playwright": "^1.60.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5"
  }
}
