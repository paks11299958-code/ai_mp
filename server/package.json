{
  "name": "shared-api-server",
  "version": "1.0.0",
  "description": "Standalone Express API server - multi-tenant",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 reload shared-api",
    "pm2:stop": "pm2 stop shared-api",
    "pm2:logs": "pm2 logs shared-api"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  }
}
